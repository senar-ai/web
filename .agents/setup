#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  echo "[$(date +%T)] $*"
}

required_major="$(cat .nvmrc)"
node_major="$(node -p 'process.versions.node.split(".")[0]')"
if (( node_major < required_major )); then
  echo "Node $required_major or later is required; found $(node -v)." >&2
  exit 1
fi

step "Installing locked npm dependencies..."
npm ci --no-audit --no-fund

step "Fetching Sheet data..."
# The site cannot build without this data, but a Sheet outage must not stop
# the orb from starting. Run `npm run fetch` again later.
if ! npm run fetch; then
  echo "Warning: Sheet fetch failed. Run 'npm run fetch' before 'npm run build'." >&2
fi

step "Orb setup complete."
